{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "coverity": {
      "type": "local",
      "command": [
        "uv",
        "run",
        "--directory",
        "/ABSOLUTE/PATH/TO/coverity_mcp",
        "python3",
        "/ABSOLUTE/PATH/TO/coverity_mcp/coverity_server.py"
      ],
      "enabled": true,
      "environment": {
        "COVERITY_USERNAME": "{env:COVERITY_USERNAME}",
        "COVERITY_AUTH_KEY": "{env:COVERITY_AUTH_KEY}",
        "PYTHONPATH": "/ABSOLUTE/PATH/TO/coverity_mcp"
      }
    }
  }
}
